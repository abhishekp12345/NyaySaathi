# Groq API Key (Free high-speed inference for Qwen 2.5 and Whisper STT)
GROQ_API_KEY=your_groq_api_key_here

# LLM Model (Uses LiteLLM: e.g. groq/qwen/qwen-2.5-32b, gemini/gemini-2.0-flash, or openai/gpt-4o-mini)
LLM_MODEL=groq/qwen/qwen-2.5-32b

# Speech-to-Text Provider (groq | gemini | sarvam | auto)
STT_PROVIDER=groq
